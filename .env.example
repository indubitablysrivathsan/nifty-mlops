# Path to the raw scraped NSE DuckDB (candL project output).
# Only needed by `python -m src.extract_features` — nothing else in this
# repo (train.py, fit_final.py, app.py, CI) touches this file.
NSE_DB_PATH=./data/nse.db

# MLflow tracking / registry
MLFLOW_TRACKING_URI=https://dagshub.com/indubitablysrivathsan/nifty-mlops.mlflow
MLFLOW_TRACKING_USERNAME=indubitablysrivathsan
MLFLOW_TRACKING_PASSWORD=
MLFLOW_EXPERIMENT_NAME=nifty_fwd_ret_20d
MLFLOW_REGISTRY_MODEL_NAME=nifty_fwd_ret_20d_model

# Promotion gate thresholds
PROMOTION_MIN_MEAN_IC=0.05
PROMOTION_MIN_POSITIVE_FOLD_PCT=0.55
PROMOTION_REGRESSION_TOLERANCE=0.0
